---
import WidgetLayout from "./WidgetLayout.astro";
import { getTagList } from "../../utils/blog-utils";

const tags = await getTagList();
---

<WidgetLayout name="Tags">
  <div class="flex flex-wrap gap-2">
    {
      tags.map((tag) => (
        <a
          href={`/blog/tags/${tag.name}`}
          class="bg-ctp-surface0 hover:bg-ctp-surface2 hover:text-ctp-blue rounded-md p-2 no-underline"
        >
          {tag.name}
        </a>
      ))
    }
  </div>
</WidgetLayout>
