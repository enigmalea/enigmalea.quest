---
interface Props {
  name?: string;
}
const { name } = Astro.props;
---

<widget-layout class="prose bg-ctp-crust max-w-none rounded-2xl pb-4">
  <div
    class="text-ctp-peach before:bg-ctp-green relative !mt-4 !mb-2 ml-8 font-mono text-2xl font-bold before:absolute before:top-[5.5px] before:left-[-16px] before:h-4 before:w-1 before:rounded-md"
  >
    {name}
  </div>
  <div class="collapse-wrapper overflow-hidden px-4">
    <slot />
  </div>
</widget-layout>
