---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

const blog = (await getCollection("posts")).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);

const currentPostIndex = blog.findIndex((post) => post.id == Astro.params.slug);
const previousPost =
  currentPostIndex + 1 === blog.length ? undefined : blog[currentPostIndex + 1];
const nextPost =
  currentPostIndex === 0 ? undefined : blog[currentPostIndex - 1];
---

{
  (previousPost || nextPost) && (
    <nav class="prose mx-auto mb-4 flex w-[95vw] max-w-none flex-col justify-between gap-4 overflow-hidden min-[860px]:max-w-prose sm:flex-row">
      {nextPost ? (
        <a
          href={`/blog/posts/${nextPost.id}`}
          class="text-ctp-text hover:text-ctp-text w-full overflow-hidden text-lg font-bold no-underline sm:w-1/2"
        >
          <div class="bg-ctp-surface0 hover:bg-ctp-surface2 flex h-15 items-center justify-start! gap-4 rounded-2xl px-4 text-right">
            <Icon name="pixelarticons:chevron-left" class="text-ctp-blue text-4xl" />
            <div class="m-0 flex flex-col truncate p-0">
              <div class="m-0 p-0 text-sm leading-tight uppercase">Next</div>

              {nextPost.data.title}
            </div>
          </div>
        </a>
      ) : (
        <div class="hidden h-15 w-1/2 flex-none items-center justify-start! gap-4 rounded-2xl bg-transparent px-4 sm:flex">
          {" "}
        </div>
      )}
      {previousPost ? (
        <a
          href={`/blog/posts/${previousPost.id}`}
          class="text-ctp-text hover:text-ctp-text w-full overflow-hidden text-lg font-bold no-underline sm:w-1/2"
        >
          <div class="bg-ctp-surface0 hover:bg-ctp-surface2 flex h-15 items-center justify-end! gap-4 rounded-2xl px-4 text-right">
            <div class="m-0 flex flex-col-reverse truncate p-0 text-right">
              {previousPost.data.title}
              <div class="m-0 p-0 text-sm leading-tight uppercase">Prev</div>
            </div>
            <Icon name="pixelarticons:chevron-right" class="text-ctp-blue text-4xl" />
          </div>
        </a>
      ) : (
        <div class="hidden h-15 w-1/2 flex-none items-center justify-start! gap-4 rounded-2xl bg-transparent px-4 sm:flex">
          {" "}
        </div>
      )}
    </nav>
  )
}
