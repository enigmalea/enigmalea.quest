---
import WidgetLayout from "./WidgetLayout.astro";
import { getCategoryList } from "../../utils/blog-utils";

const categories = await getCategoryList();
---

<WidgetLayout name="Categories">
  {
    categories.map((cat) => (
      <div>
        <a
          href={`/blog/categories/${cat.name}`}
          class="hover:text-ctp-blue no-underline"
        >
          <div class="hover:bg-ctp-surface0 mb-1 flex h-10 w-full items-center gap-4 rounded-lg px-3">
            <div class="w-full">{cat.name}</div>
            <div class="bg-ctp-blue text-ctp-crust flex h-8 w-8 justify-center rounded-md text-center">
              {String(cat.count)}
            </div>
          </div>
        </a>
      </div>
    ))
  }
</WidgetLayout>
