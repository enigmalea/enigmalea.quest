---
import { transformSocial } from "@fujocoded/zod-transform-socials/zod4";
import { Icon } from "astro-icon/components";
interface Props {
  url: string;
  class?: string;
  iconClass?: string;
}

const { url, class: className, iconClass } = Astro.props;
const social = transformSocial({ url });

const icon = social.icon ?? "pixelarticons:home-sharp";
---

<Icon name={icon} class={iconClass} />
<a
  href={social.url}
  title={social.username ?? social.platform}
  class:list={[className]}
>
  {social.username ?? social.platform}
</a>
