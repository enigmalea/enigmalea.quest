<button
  id="back-to-top"
  class="text-ctp-text hover:bg-ctp-overlay0 hover:border-ctp-green invisible absolute right-1 bottom-0 rounded-full p-1 opacity-0 transition-opacity duration-300 bg-ctp-subtext1/25 border border-ctp-sky"
  aria-label="Back to top"
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="1.75rem"
    height="1.75rem"
    viewBox="0 0 24 24"
  >
    <path d="M0 0h24v24H0z" fill="none"></path>
    <g fill="currentColor">
      <path d="M11 20h2V4h-2zm2-12h2V6h-2zm2 2h2V8h-2zm2 2h2v-2h-2zm-6-4H9V6h2z"
      ></path>
      <path d="M15 10H7V8h8zm2 2H5v-2h12z"></path>
    </g>
  </svg>
</button>

<script>
  const backToTopButton = document.getElementById("back-to-top");

  function toggleBackToTopButton() {
    if (window.scrollY > 300) {
      backToTopButton!.classList.remove("opacity-0", "invisible");
      backToTopButton!.classList.add("opacity-100", "visible");
    } else {
      backToTopButton!.classList.add("opacity-0", "invisible");
      backToTopButton!.classList.remove("opacity-100", "visible");
    }
  }

  function scrollToTop() {
    window.scrollTo({
      top: 0,
      behavior: "smooth",
    });
  }

  window.addEventListener("scroll", toggleBackToTopButton);
  backToTopButton!.addEventListener("click", scrollToTop);
</script>
