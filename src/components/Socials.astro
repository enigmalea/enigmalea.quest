---
import { Icon } from "astro-icon/components";
import UserIcon from "./UserIcon.astro";

const iconClasses = [
  "border-blue",
  "text-ctp-blue",
  "hover:text-ctp-rosewater",
  "rounded-full",
  "border p-3",
  "hover:border-transparent",
];
---

<div class="mb-5 flex justify-center gap-5 pt-4 pb-4 text-2xl sm:pt-0">
  <a
    href="mailto:admin@enigmalea.quest"
    aria-label="e-mail"
    class="border-blue text-ctp-blue hover:text-ctp-rosewater rounded-full border p-3 hover:border-transparent"
    ><Icon name="pixelarticons:mail" /></a
  >
  <UserIcon
    url="https://ao3.org/users/enigmalea/profile"
    class:list={iconClasses}
  />
  <UserIcon
    url="https://bsky.app/profile/enigmalea.quest"
    class:list={iconClasses}
  />
  <UserIcon url="https://enigmalea.tumblr.com" class:list={iconClasses} />
  <UserIcon url="https://github.com/enigmalea" class:list={iconClasses} />
</div>
