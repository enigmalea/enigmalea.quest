---
import { Icon } from "astro-icon/components";
import Social
---

<div class="mb-5 flex justify-center gap-5 pt-4 pb-4 text-2xl sm:pt-0">
  <a
    href="mailto:admin@enigmalea.quest"
    class="border-blue text-ctp-blue hover:text-ctp-rosewater rounded-full border p-3 hover:border-transparent"
    aria-label="e-mail"><Icon name="pixelarticons:mail" /></a
  >
  <a
    href="https://ao3.org/users/enigmalea/profile"
    class="border-blue text-ctp-blue hover:text-ctp-rosewater rounded-full border p-3 hover:border-transparent"
    aria-label="ArchiveOfOurOwn"><Icon name="simple-icons:archiveofourown" /></a
  >
  <a
    href="https://bsky.app/profile/enigmalea.quest"
    class="border-blue text-ctp-blue hover:text-ctp-rosewater rounded-full border p-3 hover:border-transparent"
    aria-label="BlueSky"><Icon name="simple-icons:bluesky" /></a
  >
  <a
    href="https://enigmalea.tumblr.com"
    class="border-blue text-ctp-blue hover:text-ctp-rosewater rounded-full border p-3 hover:border-transparent"
    aria-label="tumblr"><Icon name="simple-icons:tumblr" /></a
  >
  <a
    href="https://easymode.im/@enigmalea"
    class="border-blue text-ctp-blue hover:text-ctp-rosewater rounded-full border p-3 hover:border-transparent"
    aria-label="Fediverse"><Icon name="simple-icons:mastodon" /></a
  >
  <a
    href="https://github.com/enigmalea"
    class="border-blue text-ctp-blue hover:text-ctp-rosewater rounded-full border p-3 hover:border-transparent"
    aria-label="GitHub"><Icon name="simple-icons:github" /></a
  >
</div>
