---
import { Icon } from 'astro-icon/components';
import { transformSocial } from '@fujocoded/zod-transform-socials/zod4';
interface Props { 
  url: string;
  class?: string;
  iconClass?: string;
}
const { url,  class: className, iconClass } = Astro.props;
const social = transformSocial({ url });
const icon = social.icon ?? "pixelarticons:home-sharp";
---
<a href={social.url} title={social.username ?? social.platform} class:list={[className]}>
  <Icon name={icon} class:list={[iconClass]} />
</a>